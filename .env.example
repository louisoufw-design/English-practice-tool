# 目前網站不需要任何環境變數就能執行（本機模式）。
# 以下是「自架並恢復雲端同步與 Claude 審核」時才需要的變數。
# 複製成 .env 並填入真正的值；.env 已被 .gitignore 排除，絕對不要上傳。
# Anthropic API 金鑰只能放在伺服器端（例如 Cloudflare Worker 的 secret），不能寫進網頁程式碼。

# --- Claude 句子審核／查字（伺服器端中繼使用） ---
ANTHROPIC_API_KEY=YOUR_API_KEY
ANTHROPIC_MODEL=YOUR_MODEL_ID

# --- Firebase（登入與進度同步，前端設定值） ---
FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID

# --- 中繼伺服器網址（前端呼叫審核 API 用） ---
REVIEW_PROXY_URL=https://YOUR_WORKER_SUBDOMAIN.workers.dev
